# ==============================================================================
# Backend Environment Configuration (FastAPI — SIH26096 Institutional Platform)
# ==============================================================================

# Application Environment (development / production / testing)
ENVIRONMENT=development
ARCHIVE_PHASE=PHASE_10_FINAL_INTEGRATION

# Database Connection
# - Local Development: SQLite
DATABASE_URL=sqlite:///./archive_phase1.db
# - Cloud Production (Supabase Managed PostgreSQL with pgvector):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# ==============================================================================
# Supabase Managed Infrastructure (Database, Storage & Auth)
# ==============================================================================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Supabase Storage Buckets
SUPABASE_BUCKET_DOCUMENTS=archive-documents
SUPABASE_BUCKET_IMAGES=archive-images
SUPABASE_BUCKET_AUDIO=archive-audio
SUPABASE_BUCKET_DERIVATIVES=archive-derivatives

# Security & Cryptographic Tokens
SECRET_KEY=institutional_archive_secret_key_change_in_production_2026_super_secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list or JSON array of allowed frontend origins (no trailing slashes)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://frontend-kappa-six-80.vercel.app

# Phase 4 Vector & Semantic Search Backend
# - Development fallback: sqlite_dev_fallback
# - Production target: pgvector
VECTOR_BACKEND=sqlite_dev_fallback
# PGVECTOR_URL=postgresql://archive_admin:secure_password_2026@db-host:5432/ambedkar_archive
EMBEDDING_MODEL_NAME=BAAI/bge-m3
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3

# Phase 5 Source-Grounded Archival RAG & LLM Configuration
# Supported providers: "huggingface", "openai_compatible", "ollama", "mock_test"
LLM_PROVIDER=huggingface

# Hugging Face Inference API / Router (OpenAI-compatible)
HF_BASE_URL=https://router.huggingface.co/v1
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
# Server-side secret: MUST NEVER be exposed in frontend, browser, or Git
HF_TOKEN=hf_your_huggingface_inference_token_here

# For Generic OpenAI-Compatible Endpoints (Groq, vLLM, LM Studio, OpenAI):
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_your_groq_api_key_here
# LLM_MODEL=llama-3.1-8b-instant

# For Local Development with Ollama:
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3

# Phase 6 Multilingual, TTS, STT & Accessibility
TRANSLATION_PROVIDER=auto
TTS_PROVIDER=auto
STT_PROVIDER=auto

# Phase 7 Knowledge Graph Backend ("postgres" or "neo4j")
GRAPH_BACKEND=postgres
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=your_neo4j_password

# Phase 9 Kiosk, Hardware & Security Hardening
SECURITY_HEADERS_ENABLED=true
RATE_LIMIT_ENABLED=true
KIOSK_IDLE_TIMEOUT_SECONDS=120
KIOSK_WARNING_TIMEOUT_SECONDS=15
