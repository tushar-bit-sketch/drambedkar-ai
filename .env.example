# ==============================================================================
# SIH26096 — DR. B.R. AMBEDKAR DIGITAL HERITAGE ARCHIVE
# PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env or configure in your cloud container platform (Render, Railway, ECS, etc.)
# All 11 variables below define the operational institutional archival infrastructure.

# 1. DATABASE CONNECTION
# PostgreSQL with pgvector extension enabled for production vector storage.
# Direct connection (port 5432) or Supabase pooler (port 6543):
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# ==============================================================================
# SUPABASE MANAGED CLOUD INFRASTRUCTURE
# ==============================================================================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Supabase Storage Buckets
SUPABASE_BUCKET_DOCUMENTS=archive-documents
SUPABASE_BUCKET_IMAGES=archive-images
SUPABASE_BUCKET_AUDIO=archive-audio
SUPABASE_BUCKET_DERIVATIVES=archive-derivatives

# 2. CRYPTOGRAPHIC SECRET KEY
# Used for signing institutional JWT tokens and device sessions (minimum 32 random characters).
SECRET_KEY=generate_a_secure_minimum_32_character_hex_or_alphanumeric_secret_key_here

# 3. CORS ORIGINS (JSON array or comma-separated list of trusted origins)
# Must include your production Vercel frontend URL, custom domains, and local preview ports.
BACKEND_CORS_ORIGINS=["https://ambedkar-archive.vercel.app","http://localhost:5173","http://127.0.0.1:5173"]

# 4. HUGGING FACE INFERENCE API TOKEN
# Required for hosted serverless feature-extraction embeddings (BAAI/bge-m3) and LLM inference.
# Generate at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_YourHuggingFaceTokenWithInferenceAccessHere

# 5. HUGGING FACE MODEL REPOSITORY
# Default high-fidelity multilingual dense embedding model for primary source indexing.
HF_MODEL=BAAI/bge-m3

# 6. HUGGING FACE INFERENCE BASE URL
# Serverless inference router or dedicated inference endpoint.
HF_BASE_URL=https://router.huggingface.co/v1

# 7. VECTOR STORAGE BACKEND
# Options:
# - PGVECTOR (Production PostgreSQL with pgvector extension)
# - SQLITE_FALLBACK (Development local fallback with SQLite JSON storage)
VECTOR_BACKEND=PGVECTOR

# 8. S3-COMPATIBLE OBJECT STORAGE ENDPOINT
# Public HTTPS endpoint for AWS S3, Cloudflare R2, MinIO, or Wasabi master vault storage.
# Leave empty or set to 'local' for local cryptographic filesystem master vault.
OBJECT_STORAGE_ENDPOINT=https://s3.ap-south-1.amazonaws.com

# 9. OBJECT STORAGE BUCKET NAME
# Bucket holding preservation PDF/A-1b masters, TIFF facsimiles, and MP3/MP4 media dispatches.
OBJECT_STORAGE_BUCKET=ambedkar-digital-heritage-vault

# 10. OBJECT STORAGE ACCESS KEY ID
# Read/write access key for archival master ingest and presigned URL streaming.
OBJECT_STORAGE_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE

# 11. OBJECT STORAGE SECRET ACCESS KEY
# Cryptographic secret key for S3 bucket access.
OBJECT_STORAGE_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# ==============================================================================
# FRONTEND DEPLOYMENT REFERENCE (Vercel)
# ==============================================================================
# On Vercel, set:
# VITE_API_URL=https://your-api-domain.com/api/v1
# VITE_DEMO_MODE=false
